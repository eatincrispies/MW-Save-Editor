<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>NFSMWSaveEditor</AssemblyName>
    <RootNamespace>NFSMWSave.App</RootNamespace>
    <Product>NFSMW Save Editor</Product>
    <Version>1.0.2</Version>
    <Authors>eatincrispies</Authors>
    <Company>eatincrispies</Company>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <NoWarn>$(NoWarn);WFO1000;WFO5001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NFSMWSave.Core\NFSMWSave.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\*.png" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
